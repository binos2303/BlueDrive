SECRET_KEY=
DEBUG=True

DB_NAME=
DB_USER=securedrive_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

SECUREDRIVE_AES_KEY=
SECUREDRIVE_PEPPER=
SECUREDRIVE_CURRENT_KEY_ID=1

# SeaweedFS dev: xem infra/seaweedfs/README.md; dùng adapter S3 chung.
# Cutover giữ global endpoint/bucket nguồn cho legacy; đích mới dùng immutable revision.
# Không thay các giá trị này trước khi duyệt manifest/backup/restore (ADR-0008).
# Credentials may be supplied by the runtime secret manager or the standard AWS credential chain.
SECUREDRIVE_STORAGE_ENDPOINT_URL=
# Endpoint ký upload cho trình duyệt, độc lập với cờ download trực tiếp.
SECUREDRIVE_STORAGE_PUBLIC_ENDPOINT_URL=
SECUREDRIVE_DIRECT_DOWNLOAD_ENABLED=false
SECUREDRIVE_DOWNLOAD_URL_SECONDS=180
SECUREDRIVE_STORAGE_BUCKET=
SECUREDRIVE_STORAGE_REGION=us-east-1
SECUREDRIVE_STORAGE_ADDRESSING_STYLE=path
SECUREDRIVE_STORAGE_ACCESS_KEY_ID=
SECUREDRIVE_STORAGE_SECRET_ACCESS_KEY=
SECUREDRIVE_STORAGE_TLS_VERIFY=true
SECUREDRIVE_STORAGE_CA_BUNDLE=
SECUREDRIVE_STORAGE_CONNECT_TIMEOUT=2
SECUREDRIVE_STORAGE_READ_TIMEOUT=10
SECUREDRIVE_STORAGE_MAX_ATTEMPTS=3
SECUREDRIVE_STORAGE_RETRY_BASE_SECONDS=0.1
SECUREDRIVE_STORAGE_RETRY_MAX_SECONDS=1.0
SECUREDRIVE_STORAGE_PRESIGN_MAX_SECONDS=300
# Set only after storage encryption policy is approved: AES256 or aws:kms.
SECUREDRIVE_STORAGE_SSE=
SECUREDRIVE_STORAGE_KMS_KEY_ID=

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECUREDRIVE_UPLOAD_SCANNER=

# Storage Control Center: bật riêng từng gate sau khi nghiệm thu, mặc định tắt.
SECUREDRIVE_STORAGE_CONTROL_CENTER_ENABLED=false
SECUREDRIVE_STORAGE_MULTI_CLUSTER_ROUTING_ENABLED=false
SECUREDRIVE_STORAGE_AGENT_OPERATIONS_ENABLED=false
SECUREDRIVE_STORAGE_DESTRUCTIVE_OPERATIONS_ENABLED=false
# S2: mặc định chỉ kiểm tra đọc; LAB probe cần cờ riêng và xác nhận rõ trên UI.
SECUREDRIVE_STORAGE_LAB_PROBES_ENABLED=false
# Qualification trong bucket đã duyệt, không cấp quyền quản trị bucket cho runtime.
SECUREDRIVE_STORAGE_RUNTIME_PROBES_ENABLED=false
# S3: canvas và layout preference; không cấp quyền thao tác hạ tầng.
SECUREDRIVE_STORAGE_TOPOLOGY_ENABLED=false
# S4: nguồn TSDB do operator duyệt; không tự khởi chạy collector hoặc scrape node.
SECUREDRIVE_STORAGE_MONITORING_ENABLED=false
SECUREDRIVE_STORAGE_MONITORING_PROFILES={}
# JSON registry do operator cấp, không chứa giá trị secret; xem ADR-0003 và S2 runbook.
SECUREDRIVE_STORAGE_CONNECTION_PROFILES={}
