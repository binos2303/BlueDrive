+++ b/infra/postgres-test.compose.yml
@@ -0,0 +1,19 @@
+name: bluedrive-tests
+
+services:
+  postgres:
+    image: postgres:18.6@sha256:e3d24f6906d0760bf4da0dae872415391ededefad23fd471c47dc53b0ddf3c42
+    environment:
+      POSTGRES_DB: bluedrive_test_control
+      POSTGRES_USER: bluedrive_test
+      POSTGRES_PASSWORD: ${BLUEDRIVE_TEST_DB_PASSWORD:?Set a separate test password}
+    ports:
+      - 127.0.0.1:${BLUEDRIVE_TEST_DB_PORT:-55432}:5432
+    # DB test nằm trong RAM, không mount volume/dữ liệu ứng dụng hoặc Filer.
+    tmpfs:
+      - /var/lib/postgresql:size=1g
+    healthcheck:
+      test: [CMD-SHELL, 'pg_isready -U bluedrive_test -d bluedrive_test_control']
+      interval: 2s
+      timeout: 5s
+      retries: 20
