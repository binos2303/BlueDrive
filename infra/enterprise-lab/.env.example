# SeaweedFS enterprise simulator — local loopback only (NOT production).
# A second independent cluster; never reuse Platform bucket or storage data.
SEAWEED_S3_ENDPOINT=http://127.0.0.1:8433
SEAWEED_S3_PUBLIC_ENDPOINT=http://s3.localhost:8433
SEAWEED_S3_BUCKET=bluedrive-enterprise-dev
SEAWEED_S3_ACCESS_KEY=
SEAWEED_S3_SECRET_KEY=
SEAWEED_S3_ADMIN_ACCESS_KEY=
SEAWEED_S3_ADMIN_SECRET_KEY=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dedicated PostgreSQL running INSIDE this enterprise Compose project.
FILER_DB_HOST=postgres
FILER_DB_PORT=5432
FILER_DB_NAME=seaweedfs_enterprise_meta
FILER_DB_USER=seaweedfs_filer_enterprise
FILER_DB_PASSWORD=
FILER_DB_SSLMODE=disable
POSTGRES_SUPERUSER_PASSWORD=
